# pfSense API credentials (mirror from pfsense-cli/.env)
PFSENSE_HOST=https://pfsense-rtr1.bub.lan:10443
PFSENSE_API_KEY=slm
PFSENSE_API_SECRET=your-api-secret-here
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_NO_WARNINGS=1

# Uptime Kuma — pick one approach:
#
# Option A: reference a named instance from uptime-kuma-sync-n-bak/uptime-kuma-config.json
UPTIME_KUMA_INSTANCE=primary
# Override the config file path if it's not at ./config/uptime-kuma-config.json:
# UPTIME_KUMA_CONFIG=/path/to/uptime-kuma-config.json
#
# Option B: set credentials directly
# UPTIME_KUMA_URL=https://uptime-kuma2.lamolabs.org
# UPTIME_KUMA_USER=admin
# UPTIME_KUMA_PASS=your-password
